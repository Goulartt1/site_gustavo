# Modelo do arquivo .env.
# Copie para .env e preencha. O .env fica fora do git (está no .gitignore);
# este modelo vai para o git e documenta quais variáveis o projeto usa.

# Chave que o Django usa para assinar sessões, cookies e tokens.
# Cada ambiente tem a sua, e ela nunca vai para o git.
# Gere uma com: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-gerada

# True só em desenvolvimento. Em produção, sempre False (é o padrão se omitir).
DEBUG=True

# Domínios que podem servir o site, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados em formato de URL: postgres://usuario:senha@servidor:porta/banco
# O padrão do projeto é PostgreSQL (passo a passo em docs/comandos.md).
# Use só letras e números na senha: símbolos como @, : e / quebram a URL.
# Sem esta variável, o Django usa o SQLite (db.sqlite3), útil só para testes rápidos.
DATABASE_URL=postgres://site_gustavo:troque-pela-senha@localhost:5432/site_gustavo
